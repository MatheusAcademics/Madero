# EXEMPLO SEM CREDENCIAIS. Copie para .env apenas se ele ainda não existir.
# Nunca substitua o .env atual sem guardar suas configurações locais.
NODE_ENV=development
PORT=3000

# Opção local: preencha com o banco PostgreSQL do seu computador.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=madero
DB_USER=postgres
DB_PASSWORD=

# Alternativa: uma URL PostgreSQL completa substitui os campos DB_* acima.
# No Render, o Blueprint preenche DATABASE_URL automaticamente (URL interna).
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO

# disable SOMENTE para localhost ou a rede privada interna do Render.
# Para banco pela internet, use require (TLS com verificação do certificado).
DB_SSL=disable

# Obrigatório em produção: segredo longo, aleatório e exclusivo.
# Gere localmente com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Cole somente no .env local ou no painel da hospedagem; nunca no Git.
# O Blueprint do Render gera o segredo automaticamente.
SESSION_SECRET=

# 0 no computador, 1 atrás do proxy HTTPS do Render.
TRUST_PROXY_HOPS=0

# Local: mantém as fotos atuais. Render: /var/data/uploads no disco persistente.
# Não altere o diretório sem copiar os arquivos products/ e avatars/ para ele.
UPLOAD_DIR=./public/uploads
