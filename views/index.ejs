<div class="landing-loader" aria-hidden="true">
  <div class="loader-curtain"><span></span><span></span></div>
  <div class="loader-content">
    <div class="loader-mark">
      <span>M</span><span>A</span><span>D</span><span>E</span><span>R</span><span>O</span>
    </div>
    <div class="loader-track"><span></span></div>
    <div class="loader-meta">
      <p>Do campo ao prato</p>
      <p class="loader-count"><span data-loader-count>00</span><small>%</small></p>
    </div>
