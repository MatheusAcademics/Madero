<div class="about-page" data-about-page>
  <section class="about-hero" id="top" aria-labelledby="about-hero-title" data-about-hero>
    <div class="about-hero__media">
      <img
        src="/img/sobre/chef-ambiente.jpg"
        alt="Chef Junior Durski finalizando pratos em uma cozinha do Madero"
        width="1300"
        height="867"
        fetchpriority="high"
      >
    </div>
    <div class="about-hero__wash" aria-hidden="true"></div>

    <div class="about-shell about-hero__inner">
      <div class="about-hero__meta">
        <span>Uma história brasileira</span>
        <span>Curitiba · Paraná</span>
      </div>

      <div class="about-hero__heading">
        <p class="about-eyebrow">Madero · Sobre nós</p>
        <h1 id="about-hero-title" aria-label="Nossa história">
          <span class="about-hero__title-mask"><span>Nossa</span></span>
          <span class="about-hero__title-mask about-hero__title-mask--right"><span>história.</span></span>
        </h1>
      </div>

      <div class="about-hero__bottom">
        <p>Uma trajetória feita de fogo,<br>cuidado e inconformismo.</p>
        <a class="about-primary-link" href="#origem">
          <span>Conhecer a origem</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="about-origin" id="origem" aria-labelledby="about-origin-title">
    <div class="about-shell">
      <div class="about-section-index" data-about-reveal>
        <span>01</span>
        <span>A origem</span>
        <span aria-hidden="true"></span>
      </div>

      <div class="about-origin__grid">
        <p class="about-origin__aside" data-about-reveal="left">Curitiba, 1999.<br>O primeiro capítulo.</p>

        <div class="about-origin__copy">
          <h2 id="about-origin-title" data-about-reveal>
            Antes de ser uma rede,<br>foi uma <em>obsessão pessoal.</em>
          </h2>
          <p data-about-reveal>
            Chef autodidata, Junior Durski transformou o prazer de cozinhar em um plano de negócio. Em 1999, abriu o restaurante Durski. Seis anos depois, no centro histórico de Curitiba, nasceu o primeiro Madero Steak House.
          </p>
          <p data-about-reveal>
            A ideia era direta e ambiciosa: reunir ingredientes bem escolhidos, preparo cuidadoso e um ambiente acolhedor em uma experiência genuinamente brasileira.
          </p>
        </div>

        <figure class="about-founder" data-about-reveal="image" data-founder-media>
          <div class="about-founder__year" aria-hidden="true">1999</div>
          <div class="about-founder__frame">
            <img
              src="/img/sobre/junior-durski.jpg"
              alt="Retrato do chef e fundador Junior Durski"
              width="800"
              height="979"
              loading="lazy"
              decoding="async"
            >
          </div>
          <figcaption>
            <span>Junior Durski</span>
            <span>Chef e fundador</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="about-timeline" id="trajetoria" aria-labelledby="about-timeline-title" data-timeline-section>
    <div class="about-shell">
      <div class="about-section-index about-section-index--light" data-about-reveal>
        <span>02</span>
        <span>A trajetória</span>
        <span aria-hidden="true"></span>
      </div>

      <div class="about-timeline__heading">
        <h2 id="about-timeline-title" data-about-reveal>
          Uma ideia que ganhou<br><em>escala sem perder a origem.</em>
        </h2>
        <p data-about-reveal>
          Nove marcos contam como um restaurante de Curitiba se transformou em um grupo com diferentes formatos e presença nacional.
        </p>
      </div>
    </div>

    <nav class="about-years" aria-label="Anos da história" data-timeline-nav>
      <div class="about-shell about-years__inner">
        <span class="about-years__label">Navegue</span>
        <a href="#ano-1999" class="is-active" data-year-link="0">1999</a>
        <a href="#ano-2005" data-year-link="1">2005</a>
        <a href="#ano-2014" data-year-link="2">2014</a>
        <a href="#ano-2015" data-year-link="3">2015</a>
        <a href="#ano-2017" data-year-link="4">2017</a>
        <a href="#ano-2019" data-year-link="5">2019</a>
        <a href="#ano-2020" data-year-link="6">2020</a>
        <a href="#ano-2021" data-year-link="7">2021</a>
        <a href="#ano-2022" data-year-link="8">2022</a>
      </div>
      <span class="about-years__progress" aria-hidden="true" data-timeline-progress></span>
    </nav>

    <div class="about-shell about-timeline__layout">
      <div class="about-timeline__visual" aria-hidden="true" data-timeline-visual>
        <div class="about-timeline__frame">
          <img class="is-active" src="/img/sobre/chef-ambiente.jpg" alt="" width="1300" height="867" loading="lazy" decoding="async" data-timeline-image="0">
          <img src="/img/sobre/arquitetura-01.jpg" alt="" width="1200" height="761" loading="lazy" decoding="async" data-timeline-image="1">
          <img src="/img/sobre/arquitetura-05.jpg" alt="" width="1200" height="800" loading="lazy" decoding="async" data-timeline-image="2">
          <img src="/img/sobre/filme-cozinha.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" data-timeline-image="3">
          <img src="/img/2017.jpeg" alt="" width="1920" height="1499" loading="lazy" decoding="async" data-timeline-image="4">
          <img src="/img/sobre/arquitetura-03.jpg" alt="" width="1600" height="1068" loading="lazy" decoding="async" data-timeline-image="5">
          <img src="/img/2020.jpg" alt="" width="2304" height="1296" loading="lazy" decoding="async" data-timeline-image="6">
          <img src="/img/sobre/aeroporto-brasilia-fachada.jpg" alt="" width="2752" height="1835" loading="lazy" decoding="async" data-timeline-image="7">
          <img src="/img/sobre/arquitetura-06.jpg" alt="" width="1600" height="1068" loading="lazy" decoding="async" data-timeline-image="8">
          <span class="about-timeline__veil"></span>
          <div class="about-timeline__counter">
            <span data-current-year>1999</span>
            <span>09 capítulos</span>
          </div>
        </div>
      </div>

      <div class="about-timeline__entries">
        <article class="about-era is-active" id="ano-1999" data-timeline-entry="0">
          <div class="about-era__mobile-media">
            <img src="/img/sobre/chef-ambiente.jpg" alt="Chef Junior Durski trabalhando na cozinha" width="1300" height="867" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">01 / 09</span>
          <time datetime="1999">1999</time>
          <div class="about-era__copy">
            <h3>O primeiro capítulo</h3>
            <p>Em Curitiba, Junior Durski transforma o hobby de cozinhar em negócio e inaugura o Durski, seu primeiro restaurante.</p>
          </div>
        </article>

        <article class="about-era" id="ano-2005" data-timeline-entry="1">
          <div class="about-era__mobile-media">
            <img src="/img/sobre/arquitetura-01.jpg" alt="Entrada de um restaurante Madero Steak House" width="1200" height="761" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">02 / 09</span>
          <time datetime="2005">2005</time>
          <div class="about-era__copy">
            <h3>Nasce o Madero</h3>
            <p>Em 7 de junho, abre o primeiro Madero Steak House no centro histórico de Curitiba, ao lado do restaurante Durski.</p>
          </div>
        </article>

        <article class="about-era" id="ano-2014" data-timeline-entry="2">
          <div class="about-era__mobile-media">
            <img src="/img/sobre/arquitetura-05.jpg" alt="Fachada de um Madero Container" width="1200" height="800" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">03 / 09</span>
          <time datetime="2014">2014</time>
          <div class="about-era__copy">
            <h3>Um novo formato</h3>
            <p>O primeiro Madero Container leva a marca ao modelo fast-casual, com operação mais rápida e cardápio concentrado nos hambúrgueres grelhados.</p>
          </div>
        </article>

        <article class="about-era" id="ano-2015" data-timeline-entry="3">
          <div class="about-era__mobile-media">
            <img src="/img/sobre/filme-cozinha.jpg" alt="Produção de pães na Cozinha Central do Madero" width="1280" height="720" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">04 / 09</span>
          <time datetime="2015">2015</time>
          <div class="about-era__copy">
            <h3>Cozinha Central</h3>
            <p>A primeira fase da Cozinha Central é inaugurada em Ponta Grossa, reunindo produção, suprimentos e distribuição para sustentar a expansão.</p>
          </div>
        </article>

        <article class="about-era" id="ano-2017" data-timeline-entry="4">
          <div class="about-era__mobile-media">
            <img src="/img/2017.jpeg" alt="Fachada compartilhada por Madero e Jeronimo" width="1920" height="1499" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">05 / 09</span>
          <time datetime="2017">2017</time>
          <div class="about-era__copy">
            <h3>Chega o Jeronimo</h3>
            <p>O Grupo lança uma nova marca fast-casual centrada em tecnologia, com os formatos Jeronimo Burger e Jeronimo Track.</p>
          </div>
        </article>

        <article class="about-era" id="ano-2019" data-timeline-entry="5">
          <div class="about-era__mobile-media">
            <img src="/img/sobre/arquitetura-03.jpg" alt="Salão de restaurante Madero com madeira e vegetação" width="1600" height="1068" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">06 / 09</span>
          <time datetime="2019">2019</time>
          <div class="about-era__copy">
            <h3>Parceria para crescer</h3>
            <p>Um investimento relacionado ao The Carlyle Group impulsiona a estratégia de expansão e o desenvolvimento da governança corporativa.</p>
          </div>
        </article>

        <article class="about-era" id="ano-2020" data-timeline-entry="6">
          <div class="about-era__mobile-media">
            <img src="/img/2020.jpg" alt="Interior verde e iluminado de uma Ecoparada Madero" width="2304" height="1296" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">07 / 09</span>
          <time datetime="2020">2020</time>
          <div class="about-era__copy">
            <h3>Primeira Ecoparada</h3>
            <p>Na Rodovia Castello Branco, em São Paulo, nasce um complexo gastronômico pensado para reunir diferentes operações do Grupo nas estradas.</p>
          </div>
        </article>

        <article class="about-era" id="ano-2021" data-timeline-entry="7">
          <div class="about-era__mobile-media">
            <img src="/img/sobre/aeroporto-brasilia-fachada.jpg" alt="Fachada do Madero Steak House no Aeroporto de Brasília" width="2752" height="1835" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">08 / 09</span>
          <time datetime="2021">2021</time>
          <div class="about-era__copy">
            <h3>Governança em evolução</h3>
            <p>O Grupo obtém o registro de companhia aberta na CVM e recebe um novo aporte para financiar a expansão sustentável da rede.</p>
          </div>
        </article>

        <article class="about-era" id="ano-2022" data-timeline-entry="8">
          <div class="about-era__mobile-media">
            <img src="/img/sobre/arquitetura-06.jpg" alt="Cozinha aberta e salão de um Madero Container" width="1600" height="1068" loading="lazy" decoding="async">
          </div>
          <span class="about-era__index">09 / 09</span>
          <time datetime="2022">2022</time>
          <div class="about-era__copy">
            <h3>275 operações</h3>
            <p>O ano termina com 275 operações na rede, somando Steak House, Container, Jeronimo, Durski, Ecoparadas e Dundee Chicken &amp; Burgers.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="about-values" aria-labelledby="about-values-title">
    <div class="about-shell">
      <div class="about-section-index" data-about-reveal>
        <span>03</span>
        <span>O jeito Madero</span>
        <span aria-hidden="true"></span>
      </div>

      <div class="about-values__heading">
        <h2 id="about-values-title" data-about-reveal>
          Do campo ao prato,<br><em>o detalhe faz a diferença.</em>
        </h2>
        <p data-about-reveal>
          A experiência nasce muito antes de o pedido chegar à mesa. Ela atravessa a origem dos ingredientes, o preparo e o espaço que recebe cada pessoa.
        </p>
      </div>

      <div class="about-values__grid">
        <article class="about-value about-value--wide" data-about-reveal="image">
          <div class="about-value__media">
            <img src="/img/sobre/filme-campo.jpg" alt="Palmito sendo servido ao lado de produtos Madero" width="1280" height="720" loading="lazy" decoding="async">
          </div>
          <div class="about-value__meta">
            <span>01</span>
            <h3>Origem</h3>
            <p>Escolher bem cada ingrediente é o primeiro gesto de cuidado.</p>
          </div>
        </article>

        <article class="about-value about-value--tall" data-about-reveal="image">
          <div class="about-value__media">
            <img src="/img/sobre/filme-cozinha.jpg" alt="Pães sendo preparados na Cozinha Central" width="1280" height="720" loading="lazy" decoding="async">
          </div>
          <div class="about-value__meta">
            <span>02</span>
            <h3>Processo</h3>
            <p>Escala e consistência sem abrir mão da atenção ao preparo.</p>
          </div>
        </article>

        <article class="about-value about-value--offset" data-about-reveal="image">
          <div class="about-value__media">
            <img src="/img/sobre/aeroporto-brasilia-salao.jpg" alt="Salão acolhedor do Madero Steak House no Aeroporto de Brasília" width="2752" height="1835" loading="lazy" decoding="async">
          </div>
          <div class="about-value__meta">
            <span>03</span>
            <h3>Encontro</h3>
            <p>Madeira, luz e conforto unem o rústico ao sofisticado.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="about-finale" aria-labelledby="about-finale-title" data-about-finale>
    <div class="about-finale__media" aria-hidden="true">
      <img src="/img/sobre/ecoparada.jpg" alt="" width="2400" height="1600" loading="lazy" decoding="async">
    </div>
    <div class="about-finale__wash" aria-hidden="true"></div>
    <div class="about-shell about-finale__inner">
      <p data-about-reveal>Uma história que continua</p>
      <h2 id="about-finale-title" data-about-reveal>
        Feita de gente,<br>ingredientes e <em>tempo.</em>
      </h2>
      <a href="/cardapio" data-about-reveal>
        <span>Conhecer o cardápio</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>

  <footer class="about-footer">
    <div class="about-shell">
      <p class="about-footer__wordmark" aria-hidden="true" data-about-reveal>MADERO</p>

      <%- include('partials/public-footer', { currentPage: 'about' }) %>
    </div>
  </footer>
</div>
